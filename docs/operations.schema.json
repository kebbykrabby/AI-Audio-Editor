{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-editor/operations.schema.json",
  "title": "Audio Editor Operation (V2)",
  "description": "Schema for a single audio edit operation. Uses discriminated union on 'type' for per-operation parameter validation.",
  "type": "object",
  "required": ["type", "parameters"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["trim", "delete", "fade_in", "fade_out", "gain", "normalize", "reverse", "remove_silence", "extract_channel", "swap_channels", "mono_mixdown", "speed"]
    },
    "parameters": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "trim" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["start_sec", "end_sec"],
            "properties": {
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "delete" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["start_sec", "end_sec"],
            "properties": {
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "fade_in" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["duration_sec"],
            "properties": {
              "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
              "curve": {
                "type": "string",
                "enum": ["linear", "exponential"],
                "default": "linear"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "fade_out" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["duration_sec"],
            "properties": {
              "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
              "curve": {
                "type": "string",
                "enum": ["linear", "exponential"],
                "default": "linear"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "gain" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["gain_db"],
            "properties": {
              "gain_db": { "type": "number", "minimum": -60, "maximum": 24 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "normalize" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["target_db"],
            "properties": {
              "target_db": { "type": "number", "minimum": -60, "maximum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "reverse" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "remove_silence" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "threshold_db": { "type": "number", "minimum": -80, "maximum": 0, "default": -40 },
              "min_silence_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 10, "default": 0.5 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "extract_channel" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["channel"],
            "properties": {
              "channel": { "type": "string", "enum": ["left", "right"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "swap_channels" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "mono_mixdown" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "speed" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["factor"],
            "properties": {
              "factor": { "type": "number", "minimum": 0.25, "maximum": 4.0 }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
