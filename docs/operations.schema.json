{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-editor/operations.schema.json",
  "title": "Audio Editor Operation (V1)",
  "description": "Schema for a single audio edit operation. Uses discriminated union on 'type' for per-operation parameter validation.",
  "type": "object",
  "required": ["type", "input_asset_id", "parameters"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["trim", "delete", "fade_in", "fade_out", "gain", "normalize"]
    },
    "input_asset_id": {
      "type": "string",
      "pattern": "^ast_[A-Za-z0-9_-]{3,64}$"
    },
    "parameters": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "trim" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["start_sec", "end_sec"],
            "properties": {
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "delete" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["start_sec", "end_sec"],
            "properties": {
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "fade_in" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["duration_sec"],
            "properties": {
              "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
              "curve": {
                "type": "string",
                "enum": ["linear", "exponential"],
                "default": "linear"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "fade_out" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["duration_sec"],
            "properties": {
              "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
              "curve": {
                "type": "string",
                "enum": ["linear", "exponential"],
                "default": "linear"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "gain" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["gain_db"],
            "properties": {
              "gain_db": { "type": "number", "minimum": -60, "maximum": 24 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "normalize" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "required": ["target_db"],
            "properties": {
              "target_db": { "type": "number", "minimum": -60, "maximum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
