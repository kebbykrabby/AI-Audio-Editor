# AI Audio Editor — backend environment
#
# RENAME THIS FILE to backend/.env (leading dot) — the harness blocks writing
# dotfiles directly, but pydantic-settings reads .env at runtime. A one-time:
#     git mv backend/env.example backend/.env.example     (if you want to track it)
#   and/or
#     cp backend/env.example backend/.env                 (actual local config)
#
# Every key here mirrors a setting in app/config.py.
#
# ============================================================
# CORE
# ============================================================

# Postgres connection string (asyncpg driver for API; workers auto-convert to psycopg).
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://audio:audio_dev@localhost:5432/audio_editor

# Frontend origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# Max upload size (megabytes).
MAX_UPLOAD_SIZE_MB=100

# Used for building redirect URLs (e.g. after OAuth callback).
FRONTEND_BASE_URL=http://localhost:5173

# ============================================================
# QUEUE / WORKERS
# ============================================================

REDIS_URL=redis://localhost:6379/0

# Threshold for marking still-"running" rows as failed on API startup.
# MUST be > WORKER_TIME_LIMIT_SEC/60 + safety margin or legitimate jobs are killed.
WORKER_STALE_RUNNING_MIN=40

# Per-job hard ceiling inside a Dramatiq actor (seconds). 30 min default.
WORKER_TIME_LIMIT_SEC=1800

# Drop broker messages older than this (seconds). 1 h default.
WORKER_AGE_LIMIT_SEC=3600

# ============================================================
# STORAGE
# ============================================================

# "local" serves files via /files/* mount (dev only).
# "s3" uses signed URLs; fill in S3_* below.
STORAGE_BACKEND=local

# Local backend: directory root (relative OK).
STORAGE_ROOT=./storage

# URL prefix for LocalStorage signed_url (served by StaticFiles).
STORAGE_LOCAL_URL_PREFIX=/files

# Signed-URL TTL for S3 backend (seconds). 10-min default; frontend pre-emptively
# refetches at 8 min while viewing an asset, giving a 2-min safety margin.
SIGNED_URL_TTL_SEC=600

# ============================================================
# S3-COMPATIBLE (AWS S3 / Cloudflare R2 / MinIO)
# ============================================================
# Only needed when STORAGE_BACKEND=s3.
# docker-compose.yml starts a MinIO instance with these credentials already
# pre-configured; the entries below match that dev setup.

# Endpoint URL (null for AWS). http://localhost:9000 for local MinIO.
# S3_ENDPOINT_URL=http://localhost:9000

# S3_BUCKET=audio-editor
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minio_dev
# S3_SECRET_ACCESS_KEY=minio_dev_secret

# MinIO requires path-style URLs.
# S3_USE_PATH_STYLE=true

# Optional CDN / public base URL to rewrite signed URLs.
# S3_PUBLIC_URL_BASE=

# ============================================================
# JWT / ACCESS TOKENS
# ============================================================

# CHANGE_ME in production. 32+ byte random value. Keep this secret.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-in-prod

JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# ============================================================
# COOKIES
# ============================================================

# true in prod (requires HTTPS). Keep false for local dev over http://.
COOKIE_SECURE=false

# null for "same origin as request". Set explicitly in prod.
# COOKIE_DOMAIN=

COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh
CSRF_COOKIE_NAME=csrf
CSRF_HEADER_NAME=X-CSRF-Token

# ============================================================
# OTP (phone login)
# ============================================================

OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_PHONE_PER_MIN=1
OTP_RATE_PHONE_PER_HOUR=5
OTP_RATE_IP_PER_HOUR=10

# ============================================================
# SMS PROVIDER
# ============================================================
# "console" logs OTP codes to stdout (dev); "twilio" actually sends.

SMS_PROVIDER=console

# Required when SMS_PROVIDER=twilio. CHANGE_ME in prod.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=CHANGE_ME
# TWILIO_FROM_NUMBER=+15555555555

# ============================================================
# GOOGLE OAUTH
# ============================================================
# Leave blank to disable Google sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI must match GOOGLE_REDIRECT_URI below.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# ============================================================
# APPLE SIGN-IN
# ============================================================
# Leave blank to disable Apple sign-in.
# APPLE_CLIENT_ID is your Services ID (e.g. com.example.web).
# APPLE_PRIVATE_KEY_PATH points at the AuthKey_XXXXXXX.p8 downloaded from Apple.

# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXX.p8
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/apple/callback
