# AI Audio Editor — backend environment
#
# RENAME THIS FILE to backend/.env (leading dot) — the harness blocks writing
# dotfiles directly, but pydantic-settings reads .env at runtime. A one-time:
#     git mv backend/env.example backend/.env.example     (if you want to track it)
#   and/or
#     cp backend/env.example backend/.env                 (actual local config)
#
# Every key here mirrors a setting in app/config.py.
#
# ============================================================
# CORE
# ============================================================

# Postgres connection string (asyncpg driver for API; workers auto-convert to psycopg).
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://audio:audio_dev@localhost:5432/audio_editor

# Frontend origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# Max upload size (megabytes).
MAX_UPLOAD_SIZE_MB=100

# Used for building redirect URLs (e.g. after OAuth callback).
FRONTEND_BASE_URL=http://localhost:5173

# ============================================================
# QUEUE / WORKERS
# ============================================================

REDIS_URL=redis://localhost:6379/0

# Threshold for marking still-"running" rows as failed on API startup.
# MUST be > WORKER_TIME_LIMIT_SEC/60 + safety margin or legitimate jobs are killed.
WORKER_STALE_RUNNING_MIN=40

# Per-job hard ceiling inside a Dramatiq actor (seconds). 30 min default.
WORKER_TIME_LIMIT_SEC=1800

# Drop broker messages older than this (seconds). 1 h default.
WORKER_AGE_LIMIT_SEC=3600

# ============================================================
# STORAGE
# ============================================================

# "local" serves files via /files/* mount (dev only).
# "s3" uses signed URLs; fill in S3_* below.
STORAGE_BACKEND=local

# Local backend: directory root (relative OK).
STORAGE_ROOT=./storage

# URL prefix for LocalStorage signed_url (served by StaticFiles).
STORAGE_LOCAL_URL_PREFIX=/files

# Signed-URL TTL for S3 backend (seconds). 10-min default; frontend pre-emptively
# refetches at 8 min while viewing an asset, giving a 2-min safety margin.
SIGNED_URL_TTL_SEC=600

# ============================================================
# S3-COMPATIBLE (AWS S3 / Cloudflare R2 / MinIO)
# ============================================================
# Only needed when STORAGE_BACKEND=s3.
# docker-compose.yml starts a MinIO instance with these credentials already
# pre-configured; the entries below match that dev setup.

# Endpoint URL (null for AWS). http://localhost:9000 for local MinIO.
# S3_ENDPOINT_URL=http://localhost:9000

# S3_BUCKET=audio-editor
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minio_dev
# S3_SECRET_ACCESS_KEY=minio_dev_secret

# MinIO requires path-style URLs.
# S3_USE_PATH_STYLE=true

# Optional CDN / public base URL to rewrite signed URLs.
# S3_PUBLIC_URL_BASE=

# ============================================================
# JWT / ACCESS TOKENS
# ============================================================

# CHANGE_ME in production. 32+ byte random value. Keep this secret.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-in-prod

JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# ============================================================
# COOKIES
# ============================================================

# true in prod (requires HTTPS). Keep false for local dev over http://.
COOKIE_SECURE=false

# null for "same origin as request". Set explicitly in prod.
# COOKIE_DOMAIN=

COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh
CSRF_COOKIE_NAME=csrf
CSRF_HEADER_NAME=X-CSRF-Token

# ============================================================
# GOOGLE OAUTH
# ============================================================
# Leave blank to disable Google sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI must match GOOGLE_REDIRECT_URI below.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# ============================================================
# APPLE SIGN-IN
# ============================================================
# Leave blank to disable Apple sign-in.
# APPLE_CLIENT_ID is your Services ID (e.g. com.example.web).
# APPLE_PRIVATE_KEY_PATH points at the AuthKey_XXXXXXX.p8 downloaded from Apple.

# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXX.p8
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/apple/callback

# ============================================================
# AI / TRANSCRIPTION
# ============================================================
# Provider selection:
#   "local"  — faster-whisper, runs on this machine. No API key, no per-call
#              cost. Model downloaded once on first transcribe, cached under
#              ~/.cache/huggingface. Recommended default for dev + MVP.
#   "fake"   — FakeTranscriptionProvider, no network, no model. Used by tests.
#   "openai" — REST against OpenAI Whisper (paid). Kept for future swap back;
#              requires OPENAI_API_KEY.
TRANSCRIPTION_PROVIDER=local

# --- Local whisper (faster-whisper) ---
# Only read when TRANSCRIPTION_PROVIDER=local.
# Model size vs speed/accuracy tradeoff on CPU for a 3-min clip:
#   tiny   ~75 MB   ~15-30 s
#   base   ~140 MB  ~30-60 s   <-- good default
#   small  ~460 MB  ~1-2 min
#   medium ~1.5 GB  ~3-5 min
#   large-v3 ~3 GB  ~5-10 min  (use with CUDA)
WHISPER_LOCAL_MODEL=base

# "auto" picks CUDA when available, else CPU.
WHISPER_LOCAL_DEVICE=auto

# "auto" picks int8 on CPU and float16 on GPU. Override if you know better.
WHISPER_LOCAL_COMPUTE_TYPE=auto

# --- Cloud whisper (OpenAI) ---
# Only read when TRANSCRIPTION_PROVIDER=openai. Leave commented to keep the
# feature local-only.
# OPENAI_API_KEY=CHANGE_ME
WHISPER_MODEL=whisper-1

# Per-operation USD cost ceiling. Admission rejects above this.
AI_PER_OP_USD=0.50

# Input hard caps matched to Whisper-1 API limits (25 MB / effectively unbounded
# duration, but we bound at 30 min for latency + cost predictability).
AI_MAX_INPUT_DURATION_SEC=1800
AI_MAX_INPUT_SIZE_MB=24

# AI-op rate limits enforced in Redis (reuses the OTP-limiter primitives).
AI_OPS_PER_HOUR_PER_USER=5
AI_OPS_PER_DAY_PER_USER=20
AI_OPS_PER_HOUR_PER_IP=10

# ============================================================
# NATURAL-LANGUAGE EDITING (NLE)
# ============================================================
# Provider selection:
#   "fake"      — FakeLLMProvider; no network, no model. Default for tests + offline dev.
#   "gemini"    — Google Gemini 2.0 Flash via Google AI Studio. FREE TIER:
#                 ~1500 requests/day, 15/min. Get a key for free (no card
#                 required) at https://aistudio.google.com/app/apikey
#   "anthropic" — Claude API. Requires ANTHROPIC_API_KEY.
#   "openai"    — GPT-4o. Reuses OPENAI_API_KEY from the Whisper section above.
LLM_PROVIDER=fake

# --- Gemini (MVP default real provider) ---
# GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic (Phase 5 alternative) ---
# ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (Phase 5 alternative; key reused from Whisper section above) ---
OPENAI_LLM_MODEL=gpt-4o

# Per-plan USD ceiling. Admission rejects above this. Gemini free tier ≈ $0;
# raise this only if you switch to a paid provider with significant per-call cost.
NLE_PER_PLAN_USD=0.10

# Hard cap on tool calls per plan to prevent runaway chains.
NLE_MAX_TOOL_CALLS=10
